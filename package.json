{
  "name": "chords-workspace",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter @chords/web dev",
    "build": "bun run --filter @chords/web build",
    "preview": "bun run --filter @chords/web preview",
    "typecheck": "bun run --filter @chords/web typecheck",
    "test": "bun test packages apps/web/src/server",
    "check": "biome check .",
    "format": "biome format --write .",
    "db:migrate": "bun run --filter @chords/web db:migrate",
    "deploy": "bun run --filter @chords/web deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@types/bun": "latest",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^22.10.2",
    "fake-indexeddb": "^6.2.4",
    "typescript": "^6.0.2"
  }
}
