{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "chords",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "d1_databases": [{ "binding": "DB", "database_name": "chords", "database_id": "4026fa4f-3cfe-4fd2-a53d-a619b186f1b0", "migrations_dir": "migrations" }],
  "browser": { "binding": "BROWSER" },
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["welcome@micdrop.day"] }],
  "routes": [{ "pattern": "micdrop.day", "custom_domain": true }],
  // Gives each Preview a <preview>-chords.<subdomain>.workers.dev URL. Applied on
  // production deploys.
  "preview_urls": true,
  "vars": { "BETTER_AUTH_URL": "https://micdrop.day", "SENTRY_DSN": "https://352a2aae8de1434ebaf33c33c822bf6b@error.zias.be/3" },
  // Branch environments (`wrangler preview`). Only compatibility settings are
  // inherited from above. scripts/preview.ts adds the per-branch D1 database
  // and replaces BETTER_AUTH_URL with the Preview's own URL. SENTRY_DSN stays
  // empty so Previews don't report to Sentry.
  "previews": {
    "observability": { "enabled": true, "traces": { "enabled": true } },
    "browser": { "binding": "BROWSER" },
    "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["welcome@micdrop.day"] }],
    "vars": { "BETTER_AUTH_URL": "https://micdrop.day", "SENTRY_DSN": "" }
  }
}
