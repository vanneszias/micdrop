BETTER_AUTH_SECRET=generate-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
# Optional integrations:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BRAVE_SEARCH_API_KEY=
OPENAI_API_KEY=
# PDF import provider: openai (default), gemini or mistral. Set the matching key.
PDF_IMPORT_PROVIDER=gemini
GEMINI_API_KEY=
MISTRAL_API_KEY=
# Optional model override for the chosen provider (defaults: gpt-4.1, gemini-3.8-flash, mistral-small-latest)
PDF_IMPORT_MODEL=
